PROJECT_NAME="FoodRescue AI Backend"
API_V1_STR="/api/v1"

# JWT Secret Configuration
SECRET_KEY="super_secret_jwt_key_please_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for easy local setup. For PostgreSQL, set:
# DATABASE_URL="postgresql://username:password@localhost:5432/foodrescue_db"
DATABASE_URL="sqlite:///./foodrescue.db"

# Optional AI API Key (For Gemini AI feature)
GEMINI_API_KEY=""
